# Adresse du moteur pour la version en ligne, sans barre finale.
# En local, laissez vide : Vite relaie /api vers le port 8000.
VITE_API_URL=

# Développement seulement (npm run dev) : où Vite relaie /api. Défaut : http://127.0.0.1:8000.
# À changer seulement si votre moteur tourne ailleurs (autre port, autre machine, IPv6 seul).
# API_PROXY_TARGET=http://127.0.0.1:8000

# Partage des expériences importées (Supabase, P1) : Project Settings, API.
# Adresse du projet : https://<projet>.supabase.co (un suffixe /rest/v1/ copié du tableau de bord est accepté).
# Clé : la clé publique (anon ou sb_publishable_…), jamais la clé service_role ni sb_secret_….
# Sans ces deux valeurs, l'écran Import marche mais le bouton « Créer un lien de partage » est grisé.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
